{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mop://integrations/prolowin/complete-structure-batch/1.0.0",
  "title": "Prolowin Complete Article Structure Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_system",
    "report_type",
    "source",
    "root_article",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_system": {
      "const": "PROLOWIN"
    },
    "report_type": {
      "const": "COMPLETE_ARTICLE_STRUCTURE"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "parser_version"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "exported_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "parser_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "root_article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "quantity",
        "uom_raw"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "uom_raw": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_no",
          "article_code",
          "operation_code",
          "description_raw",
          "quantity",
          "uom_raw"
        ],
        "properties": {
          "row_no": {
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "article_code": {
            "type": "string",
            "minLength": 1
          },
          "operation_code": {
            "type": "string",
            "minLength": 1
          },
          "description_raw": {
            "type": "string"
          },
          "quantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
          },
          "uom_raw": {
            "type": "string",
            "minLength": 1
          },
          "row_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    }
  }
}
