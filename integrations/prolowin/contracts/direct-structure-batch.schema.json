{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mop://integrations/prolowin/direct-structure-batch/1.0.0",
  "title": "Prolowin Direct Article Structure Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","source_system","report_type","source","root_article_code","relations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_system": {"const": "PROLOWIN"},
    "report_type": {"const": "DIRECT_ARTICLE_STRUCTURE"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename","sha256","parser_version"],
      "properties": {
        "filename": {"type":"string","minLength":1},
        "sha256": {"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "exported_at": {"type":["string","null"],"format":"date-time"},
        "parser_version": {"type":"string","minLength":1}
      }
    },
    "root_article_code": {"type":"string","minLength":1},
    "relations": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "additionalProperties":false,
        "required":["row_no","parent_article_code","child_article_code","quantity","uom_raw"],
        "properties":{
          "row_no":{"type":"integer","minimum":1},
          "sequence_no":{"type":["integer","null"],"minimum":1},
          "parent_article_code":{"type":"string","minLength":1},
          "parent_description_raw":{"type":["string","null"]},
          "child_article_code":{"type":"string","minLength":1},
          "child_description_raw":{"type":["string","null"]},
          "quantity":{"type":"string","pattern":"^[1-9][0-9]*(\\.[0-9]+)?$|^0\\.[0-9]*[1-9][0-9]*$"},
          "uom_raw":{"type":"string","minLength":1},
          "source_relation_key":{"type":["string","null"],"maxLength":200},
          "row_hash":{"type":["string","null"],"pattern":"^[a-fA-F0-9]{64}$"}
        }
      }
    }
  }
}
