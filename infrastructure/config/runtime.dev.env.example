# Copy this file to .env.runtime before starting the DEV runtime.
# .env.runtime is ignored by Git.

MOP_ENVIRONMENT=development
MOP_POSTGRES_DB=mop
MOP_POSTGRES_USER=mop
MOP_POSTGRES_PASSWORD=
MOP_WEB_HOST_PORT=8080
MOP_SESSION_TTL_MINUTES=480
MOP_SESSION_COOKIE_SECURE=false
MOP_LOGIN_MAX_FAILURES=5
MOP_LOGIN_LOCKOUT_MINUTES=15
MOP_ADMIN_USERNAME=admin
MOP_ADMIN_DISPLAY_NAME=MOP Administrator

# Do not store MOP_BOOTSTRAP_ADMIN_PASSWORD here.
# The bootstrap command prompts interactively when it is not supplied.
